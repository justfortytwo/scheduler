{
  "name": "@justfortytwo/scheduler",
  "version": "0.1.0",
  "description": "Durable job scheduler daemon for justfortytwo — drains a jobs queue and fires LLM turns behind a cheap gate.",
  "license": "MIT",
  "author": {
    "name": "Enrico Deleo",
    "url": "https://enricodeleo.com"
  },
  "homepage": "https://forty-two.it",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justfortytwo/scheduler.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "fortytwo-scheduler": "dist/index.js"
  },
  "dependencies": {
    "@justfortytwo/memory": "^0.1.5",
    "@justfortytwo/runner": "^0.1.0",
    "croner": "^10.0.0",
    "p-queue": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@justfortytwo/telegram": "^0.1.5"
  },
  "peerDependenciesMeta": {
    "@justfortytwo/telegram": {
      "optional": true
    }
  }
}
